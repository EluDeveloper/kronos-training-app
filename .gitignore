# .gitignore para Kronos Training App (Vue 3 + Vite + TypeScript)

# Node modules
node_modules/

# Build output
/dist
/app/dist

# Logs
*.log

# IDE config
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Env files
.env
.env.*

# Dependency locks
pnpm-lock.yaml
/app/pnpm-lock.yaml

# TypeScript
*.tsbuildinfo

# Coverage
coverage/

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional: ignore local files
local.settings.json

# Sensitive local data and Codex attachments
/AppKronos/Backup/*.json
/AppKronos/.codex-remote-attachments/

# Public assets (generated)
/app/public/images/
/src/assets/images/

# Others
*.swp
*.swo

# End of .gitignore
